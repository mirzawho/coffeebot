BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Ollama (text AI). API key is OPTIONAL: local Ollama needs none; a cloud
# endpoint (ollama.com) requires it, and a missing key shows customers a
# temporary-failure message (never "AI disabled"). Set OLLAMA_BASE_URL=
# (empty) to disable text AI entirely.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:cloud

APP_BASE_URL=https://example.com
DATABASE_PATH=/data/cafe.sqlite
HTTP_PORT=3000

# AI persona (style only). Defaults to persona.md NEXT TO the SQLite database
# (e.g. /data/persona.md), so it lives on the same mounted volume. The file is
# auto-created with a default on first start; edit it and restart the bot.
# Set AI_PERSONA_FILE to override (absolute, or relative to the app root).
#AI_PERSONA_FILE=

# Optional HTTP proxy for outbound calls (Telegram API + Ollama), needed when
# api.telegram.org is blocked on the network. Must be an http:// proxy —
# Bun does not support socks5. Convert a socks5 proxy with gost:
#   gost -L http://:8118 -F socks5://127.0.0.1:1080
# Inside Docker use host.docker.internal instead of 127.0.0.1:
#   OUTBOUND_PROXY_URL=http://host.docker.internal:8118
#OUTBOUND_PROXY_URL=

TIMEZONE=Asia/Tehran
LOG_LEVEL=info

# Optional: comma-separated proxy IPs allowed to set X-Forwarded-For
# (leave empty when not behind a trusted reverse proxy)
# TRUSTED_PROXIES=
